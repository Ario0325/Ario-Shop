# Production environment variables for PythonAnywhere
# This file should be placed at ~/Ario/.env on PythonAnywhere

DEBUG=False
DJANGO_SECRET_KEY=your-production-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,::1,ariaabdii.pythonanywhere.com
# Set to True only if the host forwards X-Forwarded-Proto correctly
SECURE_SSL_REDIRECT=False

# Email (password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL="Ario Shop <your-email@gmail.com>"

# N8N Webhook URLs (via Cloudflare Worker proxy)
# PythonAnywhere free plan blocks direct outbound HTTP to n8n.cloud
# Requests go: Django -> Cloudflare Worker -> n8n Cloud
# See n8n/proxy-setup/Final.md for full setup guide
N8N_WEBHOOK_URL=https://quiet-field-a090.auwubxusi27css.workers.dev/webhook/django-auth-event
N8N_WEBHOOK_SECRET=CHANGE_ME_N8N_WEBHOOK_SECRET
N8N_ORDER_WEBHOOK_URL=https://quiet-field-a090.auwubxusi27css.workers.dev/webhook/order-paid
N8N_ORDER_WEBHOOK_SECRET=CHANGE_ME_N8N_WEBHOOK_SECRET
N8N_TELEGRAM_WEBHOOK_URL=https://quiet-field-a090.auwubxusi27css.workers.dev/webhook/new-order-notify
N8N_SENDER_EMAIL=your-email@gmail.com
N8N_TIMEOUT_SECONDS=3
OTP_EXPIRY_MINUTES=15

# Shared secret between Django and the Cloudflare Worker.
# Must be identical to the Worker secret:
#   npx wrangler secret put WORKER_SHARED_SECRET
WORKER_SHARED_SECRET=CHANGE_ME_WORKER_SHARED_SECRET

# Optional: absolute path to the SQLite database (defaults to BASE_DIR/db.sqlite3)
# DB_PATH=/home/ariaabdii/Ario/db.sqlite3
